# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# Password for web UI login (HTTP Basic Auth). PICK A STRONG ONE.
# Without this, anyone who knows your URL can run commands as you.
OPENCODE_SERVER_PASSWORD=change-me-to-a-strong-password

# Username for web UI login (default: opencode)
OPENCODE_SERVER_USERNAME=opencode

# ── AI Provider Keys ─────────────────────────────────────────────────────────
# Set the keys for the providers you want to use.
# Get keys from:
#   Anthropic:  https://console.anthropic.com/
#   OpenAI:     https://platform.openai.com/api-keys
#   OpenRouter: https://openrouter.ai/keys

ANTHROPIC_API_KEY=https://ark.cn-beijing.volces.com/api/coding
OPENAI_API_KEY=
OPENROUTER_API_KEY=
